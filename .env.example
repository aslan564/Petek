# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# Target under test: a URL, or the name of a profile in PETEK_TARGETS_DIR (e.g. kadrohr, see targets/kadrohr.yaml),
# which then brings its own test API, token reference, production hosts and mail settings. Production hosts are
# refused unless PETEK_ALLOW_PRODUCTION=true.
# Example: PETEK_TARGET=kadrohr (targets/kadrohr.yaml brings KadroHR's API host, production hosts and mail domain).
PETEK_TARGET=https://staging.example.com
# Target profiles, one site per targets/<name>.yaml; the panel may run any site that has one.
PETEK_TARGETS_DIR=targets
# Hosts that are production (comma-separated, e.g. example.com,www.example.com); a target profile adds its own.
PETEK_PRODUCTION_HOSTS=
PETEK_ALLOW_PRODUCTION=false

# Target test API (/test/...), sent as X-Test-Token. Empty = oracle assertions are "N/A (no oracle)".
PETEK_TEST_TOKEN=
# test-api (ask the /test/... API when a token is set) or none (a site without a test API; never asked).
PETEK_ORACLE=test-api
# Where the /test/... API lives when it is not on the target's origin (e.g. https://api.staging.example.com). Empty = the target.
PETEK_TEST_API_URL=

# Test inbox: mailpit (catch-all Mailpit the target's SMTP points at), test-api (the target's GET /test/emails, needs the
# token), imap (your own inbox, PETEK_IMAP_*) or manual (you type each code into the panel; for the explorer's 1-3 sessions).
PETEK_MAIL_SOURCE=mailpit
PETEK_MAILPIT_URL=http://localhost:8025
# The e-mail domain used for test identities (a catch-all whose mail reaches the inbox above).
PETEK_MAIL_DOMAIN=petek.test
# Your own box (e.g. test@company.az): every tester then registers with its + address, test+<run>-<agent>@company.az,
# and its mail is matched back by that exact address. Replaces PETEK_MAIL_DOMAIN. If the site refuses '+', the report
# says so; use a catch-all domain instead.
PETEK_MAIL_INBOX=
# IMAP of that box (PETEK_MAIL_SOURCE=imap). The user defaults to PETEK_MAIL_INBOX, the port to 993 (143 without TLS).
PETEK_IMAP_HOST=
PETEK_IMAP_PORT=
PETEK_IMAP_USER=
PETEK_IMAP_PASSWORD=
PETEK_IMAP_TLS=true
PETEK_IMAP_FOLDER=INBOX

# Random string (≥ 16 chars). Two jobs: it makes generated test passwords unguessable but reproducible for the same run,
# and it is the key of the ownership code `petek verify` prints. Keep it the same on every machine that tests the same
# site; another secret gives another code and the published proof no longer matches.
PETEK_IDENTITY_SECRET=

# AI provider. Pətək is tied to no AI vendor: it uses whatever AI you have. auto (default) picks, in order: an explicit
# value here; settings and keys in the environment (PETEK_LLM_BASE_URL, PETEK_LLM_BIN, ANTHROPIC_API_KEY, OPENAI_API_KEY,
# XAI_API_KEY for Grok, OPENROUTER_API_KEY, GEMINI_API_KEY); your project's AI by its marker files (AGENTS.md ->
# codex-cli, GEMINI.md -> gemini-cli, when that CLI is installed); the known agent CLIs on PATH (codex, gemini,
# opencode), then ollama. Other agent CLIs found on PATH are fallbacks when the chosen one is unavailable. Nothing found
# = none: `petek doctor` then says how to set one up. Values: auto, cli, codex-cli, gemini-cli, opencode-cli,
# anthropic-api, openai-compat, none. The tools use your own login; nothing goes to Pətək's authors.
PETEK_LLM_PROVIDER=auto
# Empty = the model the tool or provider is configured for. Required for anthropic-api and openai-compat.
PETEK_LLM_MODEL=
# The CLI binary. For provider cli: any AI command-line tool you are logged in to (its name on PATH or a full path).
# For codex-cli, gemini-cli, opencode-cli: empty = that name on PATH.
PETEK_LLM_BIN=
# Provider cli only: the arguments, split like a shell would (no shell runs). The conversation goes to STDIN; the answer
# is read from STDOUT (the JSON object, or a JSON result envelope). Placeholders: {model} and {effort} (left out, with
# the option before them, when not set), {system} (else the system text leads STDIN), {schema}, {schema_file}.
# Example: PETEK_LLM_ARGS=-p --output-format json --model {model}
PETEK_LLM_ARGS=
# Variables removed from an AI tool's environment, comma-separated, NAME or PREFIX* (e.g. the markers of an enclosing
# agent session, which some tools refuse to run inside).
PETEK_LLM_ENV_UNSET=
# OpenAI-compatible endpoint (openai-compat): OpenAI, Grok (https://api.x.ai/v1), OpenRouter, Ollama
# (http://localhost:11434/v1), Groq, Mistral, LM Studio, and every other service with an OpenAI-compatible API.
PETEK_LLM_BASE_URL=
# API key of anthropic-api or openai-compat; ANTHROPIC_API_KEY, OPENAI_API_KEY, XAI_API_KEY, OPENROUTER_API_KEY and
# GEMINI_API_KEY are read as aliases.
PETEK_LLM_API_KEY=
# How openai-compat asks for JSON: schema (strict json_schema), json_object, prompt. A rejected mode steps down by itself.
PETEK_LLM_STRUCTURED=schema
# Reasoning effort for providers that take it (codex-cli defaults to low; cli fills {effort}; openai-compat sends
# reasoning_effort).
PETEK_LLM_EFFORT=
PETEK_LLM_CONCURRENCY=6
# The language the AI writes for you in (explorer questions and ideas, tester summaries, triage): auto = the language
# of your own instructions and scenarios; or a name such as English, Azərbaycan dili, Deutsch.
PETEK_LANGUAGE=auto

# Browser
PETEK_BROWSER_HEADLESS=true
PETEK_BROWSER_TOPOLOGY=shared-server
# Accept TLS certificates the browser does not trust (self-signed staging, a proxy that re-signs traffic). Keep false unless needed.
PETEK_BROWSER_IGNORE_TLS_ERRORS=false

# Evidence output
PETEK_EVIDENCE_DIR=evidence
PETEK_DB=evidence/petek.db

# Opt-in telemetry (off by default): local = counters only (AI calls and tokens, runs by provider and tester bucket),
# appended to evidence/telemetry/usage.jsonl on this machine. Never content, never secrets; nothing is sent anywhere.
PETEK_TELEMETRY=off

# Correlation bridge: testers send X-Petek-Correlation-Id with every request (the site's CORS must allow the header for
# cross-origin API calls), and PETEK_TRACE_LOG names the site's log file whose lines with a finding's id join its bundle.
PETEK_CORRELATION_HEADER=false

# One proxy per live tester, so the site sees each from its own IP (comma-separated scheme://[user:password@]host:port;
# http, https or socks5). A run needs at least as many as testers are live at once (campaign.wave_size); empty = all
# testers share this machine's IP, and a 429 answer is reported as a set-up gap, not a site bug.
PETEK_PROXIES=
PETEK_TRACE_LOG=
