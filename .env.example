# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# Target under test: a URL, or the name of a profile in PETEK_TARGETS_DIR (e.g. kadrohr, see targets/kadrohr.yaml),
# which then brings its own test API, token reference, production hosts and mail settings. Production hosts are
# refused unless PETEK_ALLOW_PRODUCTION=true.
PETEK_TARGET=https://staging.kadrohr.com
# Target profiles, one site per targets/<name>.yaml; the panel may run any site that has one.
PETEK_TARGETS_DIR=targets
PETEK_PRODUCTION_HOSTS=kadrohr.com,www.kadrohr.com
PETEK_ALLOW_PRODUCTION=false

# Target test API (/test/...), sent as X-Test-Token. Empty = oracle assertions are skipped.
PETEK_TEST_TOKEN=
# Where the /test/... API lives when it is not on the target's origin (e.g. https://api.staging.kadrohr.com). Empty = the target.
PETEK_TEST_API_URL=

# Test inbox: mailpit (catch-all Mailpit the target's SMTP points at), test-api (the target's GET /test/emails, needs the
# token), imap (your own inbox, PETEK_IMAP_*) or manual (you type each code into the panel; for the explorer's 1-3 sessions).
PETEK_MAIL_SOURCE=mailpit
PETEK_MAILPIT_URL=http://localhost:8025
# The e-mail domain used for test identities.
PETEK_MAIL_DOMAIN=test.kadrohr.com
# Your own box (e.g. test@company.az): every tester then registers with its + address, test+<run>-<agent>@company.az,
# and its mail is matched back by that exact address. Replaces PETEK_MAIL_DOMAIN. If the site refuses '+', the report
# says so; use a catch-all domain instead.
PETEK_MAIL_INBOX=
# IMAP of that box (PETEK_MAIL_SOURCE=imap). The user defaults to PETEK_MAIL_INBOX, the port to 993 (143 without TLS).
PETEK_IMAP_HOST=
PETEK_IMAP_PORT=
PETEK_IMAP_USER=
PETEK_IMAP_PASSWORD=
PETEK_IMAP_TLS=true
PETEK_IMAP_FOLDER=INBOX

# Random string; makes generated test passwords unguessable but reproducible for the same run.
PETEK_IDENTITY_SECRET=

# AI provider. auto (default) picks, in order: an explicit value here; keys in the environment (PETEK_LLM_BASE_URL,
# ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY); your project's AI by its marker files (CLAUDE.md -> claude-cli,
# AGENTS.md -> codex-cli, GEMINI.md -> gemini-cli, when that CLI is installed); CLIs on PATH (claude, codex, gemini,
# opencode, ollama). `petek doctor` shows the choice and why. Values: auto, claude-cli, codex-cli, gemini-cli,
# opencode-cli, anthropic-api, openai-compat. The CLIs use your own login; nothing goes to Pətək's authors.
PETEK_LLM_PROVIDER=auto
# Empty = the provider's default (claude-sonnet-5 for Claude; the CLI's own configured model for codex/gemini/opencode).
# Required for openai-compat, e.g. gpt-5-mini, llama3.1.
PETEK_LLM_MODEL=
# The CLI binary; empty = claude, codex, gemini or opencode on PATH. PETEK_CLAUDE_BIN is still read as an alias.
PETEK_LLM_BIN=
# OpenAI-compatible endpoint (openai-compat): OpenAI, Ollama (http://localhost:11434/v1), Groq, Mistral, OpenRouter, LM Studio.
PETEK_LLM_BASE_URL=
# API key of anthropic-api or openai-compat; ANTHROPIC_API_KEY, OPENAI_API_KEY and GEMINI_API_KEY are read as aliases.
PETEK_LLM_API_KEY=
# How openai-compat asks for JSON: schema (strict json_schema), json_object, prompt. A rejected mode steps down by itself.
PETEK_LLM_STRUCTURED=schema
# Reasoning effort for providers that take it (claude-cli, codex-cli default to low; openai-compat sends reasoning_effort).
PETEK_LLM_EFFORT=
PETEK_LLM_CONCURRENCY=6
# The language the AI writes for you in (explorer questions and ideas, tester summaries, triage): auto = the language
# of your own instructions and scenarios; or a name such as English, Azərbaycan dili, Deutsch.
PETEK_LANGUAGE=auto

# Browser
PETEK_BROWSER_HEADLESS=true
PETEK_BROWSER_TOPOLOGY=shared-server
# Accept TLS certificates the browser does not trust (self-signed staging, a proxy that re-signs traffic). Keep false unless needed.
PETEK_BROWSER_IGNORE_TLS_ERRORS=false

# Evidence output
PETEK_EVIDENCE_DIR=evidence
PETEK_DB=evidence/petek.db

# Opt-in telemetry (off by default): local = counters only (AI calls and tokens, runs by provider and tester bucket),
# appended to evidence/telemetry/usage.jsonl on this machine. Never content, never secrets; nothing is sent anywhere.
PETEK_TELEMETRY=off
