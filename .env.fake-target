# Local demo configuration: Pətək against the fake target (testing/fake-target on ports 18080 / 18025).
# No real secrets here — the token below only unlocks the local fake site.
PETEK_TARGET=http://127.0.0.1:18080
PETEK_PRODUCTION_HOSTS=
PETEK_ALLOW_PRODUCTION=false
PETEK_TEST_TOKEN=dev-token
PETEK_MAILPIT_URL=http://127.0.0.1:18025
PETEK_MAIL_DOMAIN=test.portal.example
PETEK_IDENTITY_SECRET=local-demo-secret
# Whatever AI this machine has (see .env.example); `petek doctor` shows which one answers.
PETEK_LLM_PROVIDER=auto
PETEK_LLM_CONCURRENCY=6
PETEK_BROWSER_HEADLESS=true
PETEK_BROWSER_TOPOLOGY=shared-server
PETEK_EVIDENCE_DIR=evidence
PETEK_DB=evidence/petek.db
